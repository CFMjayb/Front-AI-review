FRONT_API_TOKEN=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7
ANTHROPIC_MODEL_FAST=claude-haiku-4-5
ANTHROPIC_MODEL_ANALYZE=claude-sonnet-4-6

# Comma-separated Front inbox IDs to service — add/remove as needed
INBOX_IDS=

# Comma-separated Front teammate IDs whose assigned conversations to service
TEAMMATE_IDS=

LOOKBACK_DAYS=7
DRY_RUN=false
LOG_LEVEL=INFO
MAX_RUN_COST_USD=10
RUN_INTERVAL_HOURS=4

# Optional: GCP Secret Manager fallback
USE_SECRET_MANAGER=false
GCP_PROJECT=

# ── Chief of Staff (open-loop tracking) ──
# SQLite ledger path (source of truth). Defaults to data/cos.db.
COS_DB_PATH=
# Hours of silence before an "owed_to_me" loop resurfaces in the briefing.
QUIET_THRESHOLD_HOURS=36
# Addresses that are "you" — drives inbound/outbound + meeting ownership.
# Include ALL your identities (M365, diocese, CFM) so direction detection is correct.
COS_OWNER_EMAILS=jboggs@episcopalmaryland.org,jay@cfmins.org,jbentzen@cfmins.org,jbentzen@ang-md.org
# Extra calendars to pull beyond your own (comma-separated owner emails / names).
# Your own calendar ('self') is always included.
COS_CALENDARS=
# Your local timezone — calendars arrive in UTC; briefing shows + bounds the day in this zone.
COS_TIMEZONE=America/New_York
# Shared secret for the CoS MCP server (X-API-Key). Reuses MCP auth pattern.
MCP_API_KEY=

# ── Outbound email (sender layer; used by briefings, nudges, etc.) ──
# How to deliver the daily briefing: file (save only) | email (send it).
BRIEFING_DELIVERY=file
# Transport for the sender layer: front (now) | outlook | smtp (later).
SENDER_TRANSPORT=front
# Comma-separated recipient(s) for self-addressed messages.
SENDER_TO=jay@cfmins.org
# Front channel to send from. If blank, the first channel with an address is used.
SENDER_FRONT_CHANNEL_ID=
